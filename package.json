{
  "name": "quran-verse-identifier-monorepo",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"bun run backend\" \"bun run frontend\"",
    "dev:split": "powershell -ExecutionPolicy Bypass -File ./start_node_and_frontend.ps1",
    "backend": "bun run --cwd backend-node dev",
    "frontend": "bun run --cwd frontend dev",
    "build": "cd frontend && bun install && bun run build",
    "tunnel": "cmd /c cloudflared.exe tunnel --url http://localhost:3000",
    "start": "bun run dev"
  },
  "dependencies": {
    "@fastify/aws-lambda": "^6.4.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fastify": "^5.12.4",
    "multer": "^1.4.5-lts.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
